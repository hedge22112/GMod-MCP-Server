<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GModMcpServer</RootNamespace>
    <AssemblyName>GModMcpServer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also supplies the Microsoft.Extensions hosting, logging and configuration packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GModMcpServer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- Streamable HTTP transport, used only when the mcp option is passed. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!-- Windows-only: read the real command line of a running gmod.exe we didn't launch
         (WMI Win32_Process), so host_status can definitively report whether -condebug is on. -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
